<?xml version="1.0" encoding="utf-8"?>
<!--
  Главный экран: герой-блок «продолжить», недавние игры, статистика, вехи.
  Вертикальный ScrollView без вложенных списков на весь экран — на 6.67"
  это самый предсказуемый скролл.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/p3_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/p3_space_xl">

        <!-- Верхняя строка: приветствие + статус -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/p3_screen_padding"
            android:paddingEnd="@dimen/p3_screen_padding"
            android:paddingTop="@dimen/p3_space_l"
            android:paddingBottom="@dimen/p3_space_m">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/P3HomeGreeting"
                    style="@style/P3.Text.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/p3_home_greeting" />

                <TextView
                    android:id="@+id/P3HomeStatus"
                    style="@style/P3.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/p3_home_status_setup" />
            </LinearLayout>

            <ImageView
                android:id="@+id/P3HomeSettings"
                style="@style/P3.Icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/p3_ic_settings" />
        </LinearLayout>

        <!-- Герой: последняя игра -->
        <FrameLayout
            android:id="@+id/P3HomeHero"
            android:layout_width="match_parent"
            android:layout_height="@dimen/p3_hero_height"
            android:layout_marginStart="@dimen/p3_screen_padding"
            android:layout_marginEnd="@dimen/p3_screen_padding"
            android:background="@drawable/p3_hero_background"
            android:visibility="gone">

            <ImageView
                android:id="@+id/P3HomeHeroImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:alpha="0.55" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="@dimen/p3_space_l">

                <TextView
                    android:id="@+id/P3HomeHeroTitle"
                    style="@style/P3.Text.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/P3HomeHeroSubtitle"
                    style="@style/P3.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/P3HomeHeroPlay"
                    style="@style/P3.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/p3_space_m"
                    android:text="@string/p3_home_continue"
                    android:drawableStart="@drawable/p3_ic_play"
                    android:drawablePadding="@dimen/p3_space_s" />
            </LinearLayout>
        </FrameLayout>

        <!-- Недавние -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/p3_screen_padding"
            android:paddingEnd="@dimen/p3_screen_padding"
            android:paddingTop="@dimen/p3_space_l"
            android:paddingBottom="@dimen/p3_space_s">

            <TextView
                style="@style/P3.SectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/p3_home_recent" />

            <TextView
                android:id="@+id/P3HomeRecentAll"
                style="@style/P3.SectionMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/p3_home_library" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/P3HomeRecentList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/p3_screen_padding"
            android:paddingEnd="@dimen/p3_screen_padding"
            android:clipToPadding="false"
            android:orientation="horizontal" />

        <!-- Пустое состояние -->
        <LinearLayout
            android:id="@+id/P3HomeEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/p3_space_xl"
            android:visibility="gone">

            <ImageView
                style="@style/P3.Icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/p3_ic_library" />

            <TextView
                style="@style/P3.Text.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p3_space_m"
                android:text="@string/p3_home_empty_title" />

            <TextView
                style="@style/P3.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="@dimen/p3_space_s"
                android:text="@string/p3_home_empty_text" />

            <TextView
                android:id="@+id/P3HomeEmptyAction"
                style="@style/P3.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p3_space_l"
                android:text="@string/p3_home_setup" />
        </LinearLayout>

        <!-- Статистика -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/p3_screen_padding"
            android:paddingEnd="@dimen/p3_screen_padding"
            android:paddingTop="@dimen/p3_space_l">

            <LinearLayout
                style="@style/P3.StatCard"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/p3_space_s">

                <TextView
                    android:id="@+id/P3StatGames"
                    style="@style/P3.Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0" />

                <TextView
                    style="@style/P3.Text.LabelCaps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/p3_home_games" />
            </LinearLayout>

            <LinearLayout
                style="@style/P3.StatCard"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/p3_space_s">

                <TextView
                    android:id="@+id/P3StatPlaytime"
                    style="@style/P3.Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0" />

                <TextView
                    style="@style/P3.Text.LabelCaps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/p3_home_playtime" />
            </LinearLayout>

            <LinearLayout
                style="@style/P3.StatCard"
                android:layout_width="0dp"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/P3StatSessions"
                    style="@style/P3.Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0" />

                <TextView
                    style="@style/P3.Text.LabelCaps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/p3_home_sessions" />
            </LinearLayout>
        </LinearLayout>

        <!-- Достижения -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/p3_screen_padding"
            android:paddingEnd="@dimen/p3_screen_padding"
            android:paddingTop="@dimen/p3_space_l"
            android:paddingBottom="@dimen/p3_space_s">

            <TextView
                style="@style/P3.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/p3_home_milestones" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/P3HomeMilestones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/p3_screen_padding"
            android:paddingEnd="@dimen/p3_screen_padding" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
