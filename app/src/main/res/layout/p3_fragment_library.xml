<?xml version="1.0" encoding="utf-8"?>
<!-- Библиотека: поиск, фильтры-чипы, сетка постеров. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/p3_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/p3_screen_padding"
        android:paddingEnd="@dimen/p3_screen_padding"
        android:paddingTop="@dimen/p3_space_l"
        android:paddingBottom="@dimen/p3_space_m">

        <TextView
            style="@style/P3.Text.Display"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/p3_library_title" />

        <ImageView
            android:id="@+id/P3LibraryAdd"
            style="@style/P3.Icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/p3_ic_add" />
    </LinearLayout>

    <!-- Поиск -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/p3_screen_padding"
        android:layout_marginEnd="@dimen/p3_screen_padding"
        android:background="@drawable/p3_search_background"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/p3_space_m"
        android:paddingEnd="@dimen/p3_space_m">

        <ImageView
            style="@style/P3.Icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/p3_ic_search" />

        <EditText
            android:id="@+id/P3LibrarySearch"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@null"
            android:hint="@string/p3_library_search"
            android:textColor="@color/p3_text"
            android:textColorHint="@color/p3_text_tertiary"
            android:textSize="@dimen/p3_text_body"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:paddingStart="@dimen/p3_space_s"
            android:paddingEnd="0dp" />
    </LinearLayout>

    <!-- Чипы фильтров -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/p3_screen_padding"
        android:paddingEnd="@dimen/p3_screen_padding"
        android:paddingTop="@dimen/p3_space_m"
        android:paddingBottom="@dimen/p3_space_m"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/P3LibraryFilters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/P3FilterAll"
                style="@style/P3.Chip.Active"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/p3_space_s"
                android:background="@drawable/p3_chip_background_active"
                android:text="@string/p3_library_all" />

            <TextView
                android:id="@+id/P3FilterFavorites"
                style="@style/P3.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/p3_space_s"
                android:background="@drawable/p3_chip_background"
                android:text="@string/p3_library_favorites" />

            <TextView
                android:id="@+id/P3FilterSort"
                style="@style/P3.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/p3_chip_background"
                android:text="@string/p3_library_sort" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/P3LibraryGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/p3_screen_padding"
            android:paddingEnd="@dimen/p3_screen_padding"
            android:paddingBottom="@dimen/p3_space_l"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/P3LibraryEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/p3_space_xl"
            android:visibility="gone">

            <ImageView
                style="@style/P3.Icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/p3_ic_library" />

            <TextView
                style="@style/P3.Text.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p3_space_m"
                android:text="@string/p3_library_empty" />

            <TextView
                style="@style/P3.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="@dimen/p3_space_s"
                android:text="@string/p3_library_empty_hint" />

            <TextView
                android:id="@+id/P3LibraryEmptyAction"
                style="@style/P3.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/p3_space_l"
                android:text="@string/p3_library_add" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
